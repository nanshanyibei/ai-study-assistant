# 复制为 .env 后填入自己的 Key（.env 已在 .gitignore 中，不会进版本库）
LLM_PROVIDER=openai-compat
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxxx

# 主力对话模型：质量优先
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=8.0

# 辅助任务模型：标题 / query 改写 / 上下文摘要，延迟与单价优先。
# 注意必须选「能关掉思考」的模型（Qwen 系列支持 enable_thinking=false），
# 否则 max_tokens 会被推理过程吃光，正文返回空串。留空则复用主模型
LLM_FAST_MODEL=Qwen/Qwen3.5-27B
LLM_FAST_PRICE_IN=0.6
LLM_FAST_PRICE_OUT=4.8
